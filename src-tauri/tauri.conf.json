{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workbuddy-Switch2",
  "version": "0.1.5",
  "identifier": "com.wbcli.switch.proxyapi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run verify:release-runtime && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Workbuddy-Switch2",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 30
        },
        "visible": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self' asset:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "15.0"
    },
    "icon": [
      "icons/account-switch/32x32.png",
      "icons/account-switch/128x128.png",
      "icons/account-switch/128x128@2x.png",
      "icons/account-switch/icon.icns",
      "icons/account-switch/icon.ico"
    ],
    "externalBin": [],
    "resources": {
      "../runtime/cli-proxy-api-wb": "runtime/cli-proxy-api-wb",
      "../runtime/workbuddy.dylib": "runtime/workbuddy.dylib",
      "../runtime/CLIProxyAPI-LICENSE": "runtime/CLIProxyAPI-LICENSE",
      "../runtime/codebuddy-intl-cpa-LICENSE": "runtime/codebuddy-intl-cpa-LICENSE"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwNEU4RkQ5OEZCN0FGRApSV1Q5ZXZ1WS9lZ0VEd1VuVFpOYjU1OGJGd1NmMVhaWHJTSEdnNVRSSEcweUxWR05TN0h2WnloSwo=",
      "endpoints": []
    }
  }
}
